# NextGen Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Database (Supabase) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Clerk Authentication ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/api/auth/clerk-callback"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"
CLERK_WEBHOOK_SECRET="whsec_..."

# ─── Supabase Storage ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── App Config ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NextGen"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_COUNTRY="India"

# ─── Demo Accounts (used by seed script) ──────────────────────────────────
DEMO_TENANT_EMAIL="tenant@demo.nextgen.app"
DEMO_LANDLORD_EMAIL="landlord@demo.nextgen.app"
DEMO_ADMIN_EMAIL="admin@demo.nextgen.app"
DEMO_PASSWORD="Demo@123456"

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="NextGen <noreply@nextgen.app>"

# ─── Payments (Razorpay) ──────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# ─── Analytics ────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── Matching Engine ──────────────────────────────────────────────────────
MATCH_MIN_SCORE=30
MATCH_MAX_RESULTS=20
